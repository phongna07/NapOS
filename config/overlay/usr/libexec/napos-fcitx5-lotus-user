#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only

set -Eeuo pipefail

mode=${1:-}
identifier=${2:-}
[[ "$mode" == "--check" || "$mode" == "--exec" ]] || exit 2
[[ -n "$identifier" ]] || exit 2

record=$(getent passwd "$identifier") || exit 1
IFS=: read -r user _ uid _ _ home shell <<<"$record"
[[ -n "$user" && "$uid" =~ ^[0-9]+$ ]] || exit 1
[[ "$home" == /home/* ]] || exit 1
[[ "$shell" != */false && "$shell" != */nologin ]] || exit 1

if [[ "$mode" == "--check" ]]; then
    exit 0
fi

exec /usr/bin/fcitx5-lotus-server -u "$user"
