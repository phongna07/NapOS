        IFS=: read -r apt_package apt_path <<<"$apt_conffile"
        verify_installed_conffile "$ROOTFS" "$apt_package" "$apt_path" ||
            die "Package-managed APT configuration is missing or modified: $apt_path"
        case "$apt_path" in
            /etc/apt/apt.conf.d/*) apt_conf_diff_args+=("--exclude=${apt_path##*/}") ;;
            /etc/apt/preferences.d/*) apt_preferences_diff_args+=("--exclude=${apt_path##*/}") ;;
            *) die "Package-managed APT conffile is outside the approved directories: $apt_path" ;;
        esac
    done
    if ! {
        sudo diff -qr --exclude=apt.conf.d --exclude=preferences.d --exclude=sources.list.d \
            "$ROOTFS/etc/apt" "$base_reference/etc/apt" >/dev/null &&
            sudo diff "${apt_conf_diff_args[@]}" \
                "$ROOTFS/etc/apt/apt.conf.d" "$base_reference/etc/apt/apt.conf.d" >/dev/null &&
            sudo diff "${apt_preferences_diff_args[@]}" \
                "$ROOTFS/etc/apt/preferences.d" "$base_reference/etc/apt/preferences.d" >/dev/null &&
            sudo diff "${apt_sources_diff_args[@]}" \
                "$ROOTFS/etc/apt/sources.list.d" "$base_reference/etc/apt/sources.list.d" >/dev/null
    }; then
        die "Mint APT configuration changed outside approved sources and package-managed conffiles."
    fi
    chrome_source="$ROOTFS/etc/apt/sources.list.d/google-chrome.sources"
    [[ -f "$chrome_source" ]] || die "Google Chrome APT source is missing."
    validate_chrome_apt_source "$chrome_source" || die "Unexpected Google Chrome APT source configuration."
    chrome_key_fingerprint=$(primary_key_fingerprint "$ROOTFS/usr/share/keyrings/google-chrome.gpg")
    [[ "$(trim_fingerprint "$chrome_key_fingerprint")" == "$(trim_fingerprint "$GOOGLE_CHROME_SIGNING_FINGERPRINT")" ]] ||
        die "Installed Google Chrome keyring fingerprint mismatch: $chrome_key_fingerprint"
    lotus_source="$ROOTFS/etc/apt/sources.list.d/fcitx5-lotus.sources"
    [[ -f "$lotus_source" ]] || die "Fcitx5 Lotus APT source is missing."
    validate_fcitx5_lotus_apt_source "$lotus_source" ||
        die "Unexpected Fcitx5 Lotus APT source configuration."
    lotus_key_fingerprint=$(primary_key_fingerprint "$ROOTFS/usr/share/keyrings/fcitx5-lotus.gpg")
    [[ "$(trim_fingerprint "$lotus_key_fingerprint")" == \
        "$(trim_fingerprint "$FCITX5_LOTUS_SIGNING_FINGERPRINT")" ]] ||
        die "Installed Fcitx5 Lotus keyring fingerprint mismatch: $lotus_key_fingerprint"
    for package in "${packages[@]}"; do
        sudo chroot "$ROOTFS" dpkg-query -W -f='${db:Status-Abbrev}' "$package" | grep -q '^ii' ||
            die "Expected package is not installed: $package"
    done
    for package in "${remove_packages[@]}"; do
        if sudo chroot "$ROOTFS" dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null |
            grep -q '^ii'; then
            die "Package from the removal policy is still installed: $package"
        fi
    done
    [[ "$(sudo chroot "$ROOTFS" dpkg-query -W -f='${db:Status-Abbrev}' "$GOOGLE_CHROME_PACKAGE")" == ii* ]] ||
        die "Expected package is not installed: $GOOGLE_CHROME_PACKAGE"
    [[ "$(sudo chroot "$ROOTFS" dpkg-query -W -f='${Version}' "$GOOGLE_CHROME_PACKAGE")" == "$CHROME_VERSION" ]] ||
        die "Installed Google Chrome version differs from authenticated package metadata."
    [[ "$(sudo chroot "$ROOTFS" dpkg-query -W -f='${db:Status-Abbrev}' "$ONLYOFFICE_PACKAGE")" == ii* ]] ||
        die "Expected package is not installed: $ONLYOFFICE_PACKAGE"
    [[ "$(sudo chroot "$ROOTFS" dpkg-query -W -f='${Version}' "$ONLYOFFICE_PACKAGE")" == "$ONLYOFFICE_VERSION" ]] ||
        die "Installed ONLYOFFICE version differs from authenticated package metadata."
    [[ "$(sudo chroot "$ROOTFS" dpkg-query -W -f='${db:Status-Abbrev}' "$FCITX5_LOTUS_PACKAGE")" == ii* ]] ||
        die "Expected package is not installed: $FCITX5_LOTUS_PACKAGE"
    [[ "$(sudo chroot "$ROOTFS" dpkg-query -W -f='${Version}' "$FCITX5_LOTUS_PACKAGE")" == \
        "$FCITX5_LOTUS_VERSION" ]] ||
        die "Installed Fcitx5 Lotus version differs from authenticated package metadata."
    [[ "$(sudo chroot "$ROOTFS" dpkg-query -W -f='${db:Status-Abbrev}' ibus)" == ii* ]] ||
        die "IBus compatibility packages were unexpectedly purged."
    if sudo grep -Rqs --exclude='napos-build' 'Napos' \
        "$ROOTFS/etc/napos-release" "$ROOTFS/usr/lib/os-release" \
        "$ROOTFS/usr/share/applications"; then
        die 'Incorrect product capitalization "Napos" found in generated branding.'
    fi
    ok "Customized rootfs assertions passed."
}

clean_chroot() {
    log "Cleaning package and build state..."
    sudo chroot "$ROOTFS" /bin/bash -euxc '
        apt-get clean
        rm -rf /var/lib/apt/lists/* /tmp/napos-hooks /tmp/napos-packages.txt \
            /tmp/napos-packages-remove.txt /tmp/napos-google-chrome.deb \
            /tmp/napos-onlyoffice.deb /tmp/napos-fcitx5-lotus.deb \
            /tmp/napos-maintscript-bin
        rm -f /usr/sbin/policy-rc.d /var/lib/dbus/machine-id
        : > /etc/machine-id
    '
    cleanup_mounts "$ROOTFS"
    restore_dns
    require_clean_mount_state "$ROOTFS"
    for virtual_dir in dev proc sys run; do
        sudo mkdir -p "$ROOTFS/$virtual_dir"
        sudo find "$ROOTFS/$virtual_dir" -xdev -depth -mindepth 1 -delete
        if sudo find "$ROOTFS/$virtual_dir" -xdev -mindepth 1 -print -quit |
            grep -q .; then
            die "Virtual filesystem staging directory is not empty: $ROOTFS/$virtual_dir"
        fi
    done
    ok "Chroot cleaned; DNS restored; virtual directories are empty and unmounted."
}

write_installer_manifest() {
    sudo chroot "$ROOTFS" dpkg-query -W -f='${Package} ${Version}\n' |
        sudo tee "$ISO_TREE/casper/filesystem.manifest" >/dev/null
    sudo du -sx --block-size=1 "$ROOTFS" | awk '{print $1}' |
        sudo tee "$ISO_TREE/casper/filesystem.size" >/dev/null
    sudo chmod 0644 "$ISO_TREE/casper/filesystem.manifest" "$ISO_TREE/casper/filesystem.size"
}

build_squashfs() {
    local profile=$1
    local options
    sudo rm -f -- "$ISO_TREE/casper/filesystem.squashfs"
    case "$profile" in
        dev) options=(-comp lz4 -noappend) ;;
        release) options=(-comp xz -b 1M -Xdict-size 100% -noappend) ;;
        *) die "Unsupported profile: $profile" ;;
    esac
    log "Building ${profile} SquashFS..."
    sudo mksquashfs "$ROOTFS" "$ISO_TREE/casper/filesystem.squashfs" "${options[@]}"
    sudo chmod 0644 "$ISO_TREE/casper/filesystem.squashfs"
    write_installer_manifest
}

release_github_rootfs() {
    check_github_actions_ubuntu || return 0
    cleanup_mounts "$ROOTFS"
    require_clean_mount_state "$ROOTFS"
    safe_remove_tree "$ROOTFS" "$WORK_DIR"
    ok "Released the expanded GitHub Actions rootfs after packing."
}

release_github_intermediates() {
