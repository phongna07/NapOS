write_iso_md5s() {
    local temporary_md5="$META_DIR/md5sum.txt.$$"
    log "Refreshing ISO file checksums..."
    (
        cd "$ISO_TREE"
        find . -type f ! -name md5sum.txt ! -path './isolinux/boot.cat' -print0 |
            sort -z | xargs -0 md5sum >"$temporary_md5"
    )
    # The upstream ISO ships md5sum.txt as 0444. Force replacement so this
    # unattended build never prompts for confirmation on a terminal.
    mv -f -- "$temporary_md5" "$ISO_TREE/md5sum.txt"
}

