repack_iso() {
    local profile=$1
    local base_iso output tmp_output
    base_iso=$(base_iso_path)
    output=$(output_iso_for_profile "$profile")
    tmp_output="$DIST_DIR/.${output##*/}.tmp.$$"
    rm -f -- "$tmp_output" "$output"
    log "Replaying Mint's BIOS/EFI boot layout into the NapOS ISO..."
    xorriso -indev "$base_iso" -outdev "$tmp_output" \
        -volid "$ISO_VOLUME_ID" \
        -map "$ISO_TREE/casper/filesystem.squashfs" /casper/filesystem.squashfs \
        -map "$ISO_TREE/casper/filesystem.size" /casper/filesystem.size \
        -map "$ISO_TREE/casper/filesystem.manifest" /casper/filesystem.manifest \
        -map "$ISO_TREE/md5sum.txt" /md5sum.txt \
        -boot_image any replay -commit -end
    mv -- "$tmp_output" "$output"
    write_build_info "$output" "$profile"
    (
        cd "$DIST_DIR"
        sha256sum "$(basename "$output")" >"$(basename "$output").sha256"
    )
    BUILT_ISO=$output
}

resolve_iso_argument() {
    local requested=${1:-}
    if [[ -n "$requested" ]]; then
        [[ "$requested" = /* ]] || requested="$PROJECT_ROOT/$requested"
        [[ -f "$requested" ]] || die "ISO does not exist: $requested"
        realpath "$requested"
    else
        latest_iso
    fi
}

extract_verification_files() {
    local iso=$1
    local temp=$2
    xorriso -osirrox on -indev "$iso" \
        -extract /casper/filesystem.squashfs "$temp/filesystem.squashfs" \
        -extract /casper/filesystem.manifest "$temp/filesystem.manifest" \
        -extract /casper/filesystem.manifest-remove "$temp/filesystem.manifest-remove" >/dev/null 2>&1
}

read_installer_launcher() {
    local squashfs=$1
    local launcher
    for launcher in \
        usr/share/applications/ubiquity.desktop \
        usr/share/applications/live-installer.desktop \
        usr/share/applications/calamares.desktop; do
        if unsquashfs -cat "$squashfs" "$launcher" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

cmd_verify() {
    local iso temp boot_report pvd_report sidecar
    local package napos_release os_release timezone installer locale_data dconf_data
    local squashfs_report compression expected_compression base_iso
    local build_info chrome_source_file chrome_key_file chrome_key_fingerprint chrome_version
    local onlyoffice_version onlyoffice_launcher office_mime
    local lotus_source_file lotus_key_file lotus_key_fingerprint lotus_version
    local fcitx_environment fcitx_profile fcitx_config lotus_user_unit lotus_server_unit
    local copyq_autostart flameshot_autostart mimeapps mint_mimeapps grouped_window_list
    local panel_launchers theme_index theme_file
    local application_defaults launcher_defaults
    iso=$(resolve_iso_argument "${1:-}")
    [[ "$(basename "$iso")" == NapOS-*.iso ]] || die "ISO filename must begin with NapOS-."
    sidecar="${iso}.sha256"
    if [[ -f "$sidecar" ]]; then
        (cd "$(dirname "$iso")" && sha256sum -c "$(basename "$sidecar")") >/dev/null || die "ISO SHA-256 sidecar check failed."
        ok "ISO SHA-256 matches its sidecar."
    else
        warn "No checksum sidecar found; continuing with structural verification."
    fi

    pvd_report=$(xorriso -indev "$iso" -pvd_info 2>&1)
    grep -q "$ISO_VOLUME_ID" <<<"$pvd_report" || die "Unexpected ISO volume ID."
    boot_report=$(xorriso -indev "$iso" -report_el_torito plain 2>&1)
    grep -q 'BIOS' <<<"$boot_report" || die "Legacy BIOS boot entry is missing."
    grep -Eq 'UEFI|EFI' <<<"$boot_report" || die "EFI boot entry is missing."
    ok "BIOS and EFI boot entries are present."

    temp=$(with_temp_dir)
    TEMP_PATHS+=("$temp")
    extract_verification_files "$iso" "$temp"
    [[ -s "$temp/filesystem.manifest-remove" ]] || die "filesystem.manifest-remove is missing or empty."
    squashfs_report=$(unsquashfs -s "$temp/filesystem.squashfs" 2>&1) || die "SquashFS superblock validation failed."
    compression=$(awk '$1 == "Compression" {print tolower($2); exit}' <<<"$squashfs_report")
    if [[ "$(basename "$iso")" == *-dev-* ]]; then
        expected_compression=lz4
    else
        expected_compression=xz
    fi
    [[ "$compression" == "$expected_compression" ]] ||
        die "Expected $expected_compression SquashFS compression, found ${compression:-unknown}."
    ok "SquashFS is valid and uses $compression compression."

    base_iso="$DOWNLOAD_DIR/$BASE_ISO_NAME"
    if [[ -f "$base_iso" ]]; then
        xorriso -osirrox on -indev "$base_iso" \
            -extract /casper/filesystem.manifest-remove "$temp/base-filesystem.manifest-remove" >/dev/null 2>&1
        cmp -s "$temp/filesystem.manifest-remove" "$temp/base-filesystem.manifest-remove" ||
            die "filesystem.manifest-remove differs from the authenticated Mint input."
    fi
    napos_release=$(unsquashfs -cat "$temp/filesystem.squashfs" etc/napos-release 2>/dev/null) || die "/etc/napos-release is missing."
    os_release=$(unsquashfs -cat "$temp/filesystem.squashfs" usr/lib/os-release 2>/dev/null) || die "/usr/lib/os-release is missing."
    timezone=$(unsquashfs -cat "$temp/filesystem.squashfs" etc/timezone 2>/dev/null) || die "/etc/timezone is missing."
    locale_data=$(unsquashfs -cat "$temp/filesystem.squashfs" etc/default/locale 2>/dev/null) || die "/etc/default/locale is missing."
    dconf_data=$(unsquashfs -cat "$temp/filesystem.squashfs" etc/dconf/db/local.d/00-napos 2>/dev/null) || die "NapOS dconf source is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" etc/dconf/db/local >/dev/null 2>&1 || die "Compiled NapOS dconf database is missing."
    installer=$(read_installer_launcher "$temp/filesystem.squashfs") ||
        die "No supported installer launcher exists in the SquashFS."
    chrome_source_file="$temp/google-chrome.sources"
    chrome_key_file="$temp/google-chrome.gpg"
    unsquashfs -cat "$temp/filesystem.squashfs" etc/apt/sources.list.d/google-chrome.sources \
        >"$chrome_source_file" 2>/dev/null || die "Google Chrome APT source is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/keyrings/google-chrome.gpg \
        >"$chrome_key_file" 2>/dev/null || die "Google Chrome APT keyring is missing."
    validate_chrome_apt_source "$chrome_source_file" || die "Google Chrome APT source is invalid."
    chrome_key_fingerprint=$(primary_key_fingerprint "$chrome_key_file")
    [[ "$(trim_fingerprint "$chrome_key_fingerprint")" == "$(trim_fingerprint "$GOOGLE_CHROME_SIGNING_FINGERPRINT")" ]] ||
        die "Google Chrome APT keyring fingerprint mismatch: $chrome_key_fingerprint"
    lotus_source_file="$temp/fcitx5-lotus.sources"
    lotus_key_file="$temp/fcitx5-lotus.gpg"
    unsquashfs -cat "$temp/filesystem.squashfs" etc/apt/sources.list.d/fcitx5-lotus.sources \
        >"$lotus_source_file" 2>/dev/null || die "Fcitx5 Lotus APT source is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/keyrings/fcitx5-lotus.gpg \
        >"$lotus_key_file" 2>/dev/null || die "Fcitx5 Lotus APT keyring is missing."
    validate_fcitx5_lotus_apt_source "$lotus_source_file" || die "Fcitx5 Lotus APT source is invalid."
    lotus_key_fingerprint=$(primary_key_fingerprint "$lotus_key_file")
    [[ "$(trim_fingerprint "$lotus_key_fingerprint")" == \
        "$(trim_fingerprint "$FCITX5_LOTUS_SIGNING_FINGERPRINT")" ]] ||
        die "Fcitx5 Lotus APT keyring fingerprint mismatch: $lotus_key_fingerprint"
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/applications/google-chrome.desktop >/dev/null 2>&1 ||
        die "Google Chrome desktop launcher is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/applications/vlc.desktop >/dev/null 2>&1 ||
        die "VLC desktop launcher is missing."
    unsquashfs -ll "$temp/filesystem.squashfs" usr/bin/copyq 2>/dev/null |
        grep -q 'usr/bin/copyq' || die "CopyQ executable is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/applications/com.github.hluk.copyq.desktop \
        >/dev/null 2>&1 || die "CopyQ desktop launcher is missing."
    copyq_autostart=$(unsquashfs -cat "$temp/filesystem.squashfs" \
        etc/xdg/autostart/com.github.hluk.copyq.desktop 2>/dev/null) ||
        die "CopyQ global autostart entry is missing."
    grep -qx 'Exec=copyq' <<<"$copyq_autostart" ||
        die "CopyQ autostart does not start hidden."
    unsquashfs -ll "$temp/filesystem.squashfs" usr/bin/flameshot 2>/dev/null |
        grep -q 'usr/bin/flameshot' || die "Flameshot executable is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/applications/org.flameshot.Flameshot.desktop \
        >/dev/null 2>&1 || die "Flameshot desktop launcher is missing."
    flameshot_autostart=$(unsquashfs -cat "$temp/filesystem.squashfs" \
        etc/xdg/autostart/org.flameshot.Flameshot.desktop 2>/dev/null) ||
        die "Flameshot global autostart entry is missing."
    grep -qx 'Exec=flameshot' <<<"$flameshot_autostart" ||
        die "Flameshot autostart does not start the tray application."
    onlyoffice_launcher=$(unsquashfs -cat "$temp/filesystem.squashfs" \
        usr/share/applications/onlyoffice-desktopeditors.desktop 2>/dev/null) ||
        die "ONLYOFFICE desktop launcher is missing."
    if unsquashfs -cat "$temp/filesystem.squashfs" etc/apt/sources.list.d/onlyoffice.list \
        >/dev/null 2>&1 ||
        unsquashfs -cat "$temp/filesystem.squashfs" etc/apt/sources.list.d/onlyoffice.sources \
            >/dev/null 2>&1; then
        die "A persistent ONLYOFFICE APT source is present."
    fi
    unsquashfs -ll "$temp/filesystem.squashfs" usr/bin/google-chrome-stable 2>/dev/null |
        grep -q 'usr/bin/google-chrome-stable' || die "Google Chrome executable is missing."
    unsquashfs -ll "$temp/filesystem.squashfs" usr/bin/onlyoffice-desktopeditors 2>/dev/null |
        grep -q 'usr/bin/onlyoffice-desktopeditors' || die "ONLYOFFICE executable is missing."
    unsquashfs -ll "$temp/filesystem.squashfs" usr/bin/fcitx5-lotus-server 2>/dev/null |
        grep -q 'usr/bin/fcitx5-lotus-server' || die "Fcitx5 Lotus server is missing."
    unsquashfs -ll "$temp/filesystem.squashfs" usr/bin/fcitx5-lotus-settings 2>/dev/null |
        grep -q 'usr/bin/fcitx5-lotus-settings' || die "Fcitx5 Lotus settings tool is missing."
    unsquashfs -ll "$temp/filesystem.squashfs" usr/lib/x86_64-linux-gnu/fcitx5/liblotus.so 2>/dev/null |
        grep -q 'usr/lib/x86_64-linux-gnu/fcitx5/liblotus.so' || die "Fcitx5 Lotus addon is missing."
    unsquashfs -ll "$temp/filesystem.squashfs" usr/bin/fcitx5-config-qt 2>/dev/null |
        grep -q 'usr/bin/fcitx5-config-qt' || die "Fcitx5 configuration tool is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" \
        usr/share/applications/org.fcitx.fcitx5-config-qt.desktop >/dev/null 2>&1 ||
        die "Fcitx5 Configuration menu entry is missing."
    unsquashfs -ll "$temp/filesystem.squashfs" usr/libexec/napos-fcitx5-lotus-user 2>/dev/null |
        grep -q 'usr/libexec/napos-fcitx5-lotus-user' || die "Fcitx5 Lotus user resolver is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/fcitx5/addon/lotus.conf 2>/dev/null |
        grep -qx 'Library=liblotus' || die "Fcitx5 Lotus addon descriptor is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/fcitx5/inputmethod/lotus.conf 2>/dev/null |
        grep -qx 'Name=Lotus' || die "Fcitx5 Lotus input-method descriptor is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" etc/xdg/autostart/org.fcitx.Fcitx5.desktop \
        >/dev/null 2>&1 || die "Fcitx5 global autostart entry is missing."
    fcitx_environment=$(unsquashfs -cat "$temp/filesystem.squashfs" etc/environment 2>/dev/null) ||
        die "System environment configuration is missing."
    fcitx_profile=$(unsquashfs -cat "$temp/filesystem.squashfs" etc/skel/.config/fcitx5/profile 2>/dev/null) ||
        die "Fcitx5 default profile is missing."
    fcitx_config=$(unsquashfs -cat "$temp/filesystem.squashfs" etc/skel/.config/fcitx5/config 2>/dev/null) ||
        die "Fcitx5 default behavior is missing."
    lotus_user_unit=$(unsquashfs -cat "$temp/filesystem.squashfs" \
        etc/systemd/system/user@.service.d/50-napos-fcitx5-lotus.conf 2>/dev/null) ||
        die "Fcitx5 Lotus user service dependency is missing."
    lotus_server_unit=$(unsquashfs -cat "$temp/filesystem.squashfs" \
        etc/systemd/system/fcitx5-lotus-server@.service.d/10-napos-user-resolution.conf 2>/dev/null) ||
        die "Fcitx5 Lotus server override is missing."
    for setting in \
        'XMODIFIERS=@im=fcitx' \
        'GTK_IM_MODULE=fcitx' \
        'QT_IM_MODULE=fcitx' \
        'SDL_IM_MODULE=fcitx' \
        'GLFW_IM_MODULE=ibus'; do
        grep -qx "$setting" <<<"$fcitx_environment" || die "Fcitx5 environment setting is missing: $setting"
    done
    grep -qx 'DefaultIM=lotus' <<<"$fcitx_profile" || die "Lotus is not the default configured input method."
    grep -qx 'Name=keyboard-us' <<<"$fcitx_profile" || die "The English keyboard is absent from the Fcitx5 profile."
    grep -qx 'Name=lotus' <<<"$fcitx_profile" || die "Lotus is absent from the Fcitx5 profile."
    [[ "$fcitx_profile" == $'[Groups/0]\nName=Default\nDefault Layout=us\nDefaultIM=lotus\n\n[Groups/0/Items/0]\nName=keyboard-us\nLayout=\n\n[Groups/0/Items/1]\nName=lotus\nLayout=\n\n[GroupOrder]\n0=Default' ]] ||
        die "The Fcitx5 profile does not list the English keyboard before Lotus."
    grep -qx 'ActiveByDefault=False' <<<"$fcitx_config" || die "Fcitx5 does not start in English mode."
    grep -Fqx 'Wants=fcitx5-lotus-server@%i.service' <<<"$lotus_user_unit" ||
        die "Lotus is not coupled to systemd user startup."
    grep -Fqx 'ExecCondition=/usr/libexec/napos-fcitx5-lotus-user --check %i' <<<"$lotus_server_unit" ||
        die "Lotus user eligibility checking is missing."
    grep -Fqx 'ExecStart=/usr/libexec/napos-fcitx5-lotus-user --exec %i' <<<"$lotus_server_unit" ||
        die "Lotus UID-to-username resolution is missing."
    if unsquashfs -cat "$temp/filesystem.squashfs" \
        etc/systemd/system/multi-user.target.wants/fcitx5-lotus-server@root.service >/dev/null 2>&1; then
        die "Fcitx5 Lotus is incorrectly enabled for root."
    fi
    if unsquashfs -ll "$temp/filesystem.squashfs" etc/xdg/autostart 2>/dev/null |
        grep -Eq 'etc/xdg/autostart/ibus[^/]*$'; then
        die "An IBus autostart entry remains enabled."
    fi
    if unsquashfs -cat "$temp/filesystem.squashfs" usr/share/applications/firefox.desktop \
        >/dev/null 2>&1; then
        die "Firefox desktop launcher is present."
    fi
    if unsquashfs -ll "$temp/filesystem.squashfs" usr/bin/firefox 2>/dev/null |
        grep -q 'usr/bin/firefox'; then
        die "Firefox executable is present."
    fi
    mimeapps=$(unsquashfs -cat "$temp/filesystem.squashfs" usr/share/applications/mimeapps.list 2>/dev/null) ||
        die "Desktop MIME application policy is missing."
    mint_mimeapps=$(unsquashfs -cat "$temp/filesystem.squashfs" \
        usr/share/ubuntu-system-adjustments/mimeapps.list 2>/dev/null) ||
        die "Mint MIME application policy is missing."
    grouped_window_list=$(unsquashfs -cat "$temp/filesystem.squashfs" \
        usr/share/cinnamon/applets/grouped-window-list@cinnamon.org/settings-schema.json 2>/dev/null) ||
        die "Cinnamon grouped-window-list defaults are missing."
    panel_launchers=$(unsquashfs -cat "$temp/filesystem.squashfs" \
        usr/share/cinnamon/applets/panel-launchers@cinnamon.org/settings-schema.json 2>/dev/null) ||
        die "Cinnamon panel-launcher defaults are missing."
    for application_defaults in "$mimeapps" "$mint_mimeapps"; do
        grep -qx 'application/xhtml+xml=google-chrome.desktop' <<<"$application_defaults" ||
            die "Google Chrome is not the default XHTML handler."
        grep -qx 'text/html=google-chrome.desktop' <<<"$application_defaults" ||
            die "Google Chrome is not the default HTML handler."
        grep -qx 'x-scheme-handler/http=google-chrome.desktop' <<<"$application_defaults" ||
            die "Google Chrome is not the default HTTP handler."
        grep -qx 'x-scheme-handler/https=google-chrome.desktop' <<<"$application_defaults" ||
            die "Google Chrome is not the default HTTPS handler."
        grep -qx 'audio/mpeg=vlc.desktop' <<<"$application_defaults" ||
            die "VLC is not the default MPEG audio handler."
        grep -qx 'audio/ogg=vlc.desktop;org.gnome.Rhythmbox3.desktop' <<<"$application_defaults" ||
            die "VLC is not the primary Ogg audio handler."
        grep -qx 'audio/flac=org.gnome.Rhythmbox3.desktop' <<<"$application_defaults" ||
            die "The Rhythmbox-only FLAC default was not preserved."
        grep -qx 'video/mp4=vlc.desktop' <<<"$application_defaults" ||
            die "VLC is not the default MP4 video handler."
        grep -qx 'video/x-matroska=vlc.desktop' <<<"$application_defaults" ||
            die "VLC is not the default Matroska video handler."
        grep -qx 'x-content/video-dvd=vlc.desktop' <<<"$application_defaults" ||
            die "VLC is not the default video DVD handler."
        for office_mime in \
            application/msword \
            application/msword-template \
            application/vnd.ms-word.document.macroEnabled.12 \
            application/vnd.ms-word.template.macroEnabled.12 \
            application/vnd.openxmlformats-officedocument.wordprocessingml.document \
            application/vnd.openxmlformats-officedocument.wordprocessingml.template \
            application/vnd.ms-excel \
            application/vnd.ms-excel.sheet.macroEnabled.12 \
            application/vnd.ms-excel.sheet.binary.macroEnabled.12 \
            application/vnd.ms-excel.template.macroEnabled.12 \
            application/vnd.openxmlformats-officedocument.spreadsheetml.sheet \
            application/vnd.openxmlformats-officedocument.spreadsheetml.template \
            application/vnd.ms-powerpoint \
            application/vnd.ms-powerpoint.presentation.macroEnabled.12 \
            application/vnd.ms-powerpoint.slideshow.macroEnabled.12 \
            application/vnd.ms-powerpoint.template.macroEnabled.12 \
            application/vnd.openxmlformats-officedocument.presentationml.presentation \
            application/vnd.openxmlformats-officedocument.presentationml.slideshow \
            application/vnd.openxmlformats-officedocument.presentationml.template \
            application/rtf text/rtf application/csv text/csv \
            text/comma-separated-values text/x-comma-separated-values; do
            grep -Fqx "$office_mime=onlyoffice-desktopeditors.desktop" <<<"$application_defaults" ||
                die "ONLYOFFICE is not the default handler for $office_mime."
            [[ ";${onlyoffice_launcher#*MimeType=}" == *";$office_mime;"* ]] ||
                die "ONLYOFFICE launcher does not advertise $office_mime."
        done
        grep -qx 'application/pdf=xreader.desktop' <<<"$application_defaults" ||
            die "The existing PDF default was not preserved."
        grep -qx 'application/vnd.oasis.opendocument.text=libreoffice-writer.desktop' \
            <<<"$application_defaults" || die "The existing ODT default was not preserved."
        grep -qx 'application/vnd.oasis.opendocument.spreadsheet=libreoffice-calc.desktop' \
            <<<"$application_defaults" || die "The existing ODS default was not preserved."
        grep -qx 'application/vnd.oasis.opendocument.presentation=libreoffice-impress.desktop' \
            <<<"$application_defaults" || die "The existing ODP default was not preserved."
        if grep -q '=firefox.desktop$' <<<"$application_defaults"; then
            die "Firefox remains assigned as a MIME handler."
        fi
        if grep -Fq 'io.github.celluloid_player.Celluloid.desktop' <<<"$application_defaults"; then
            die "Celluloid remains assigned as a MIME handler."
        fi
    done
    for launcher_defaults in "$grouped_window_list" "$panel_launchers"; do
        grep -q 'google-chrome.desktop' <<<"$launcher_defaults" ||
            die "Google Chrome is absent from a Cinnamon launcher default."
        if grep -q 'firefox.desktop' <<<"$launcher_defaults"; then
            die "Firefox remains in a Cinnamon launcher default."
        fi
    done

    grep -qx 'NAPOS_NAME="NapOS"' <<<"$napos_release" || die "Embedded NapOS identity is incorrect."
    grep -qx "NAPOS_VERSION=\"$NAPOS_VERSION\"" <<<"$napos_release" || die "Embedded NapOS version is incorrect."
    grep -qx 'NAME="NapOS"' <<<"$os_release" || die "os-release NAME is incorrect."
    grep -qx "PRETTY_NAME=\"NapOS $NAPOS_VERSION\"" <<<"$os_release" || die "os-release PRETTY_NAME is incorrect."
    grep -qx 'ID=linuxmint' <<<"$os_release" || die "Mint technical ID was not preserved."
    grep -qx "VERSION_CODENAME=$BASE_CODENAME" <<<"$os_release" || die "Mint codename was not preserved."
    grep -qx "UBUNTU_CODENAME=$UBUNTU_CODENAME" <<<"$os_release" || die "Ubuntu codename was not preserved."
    [[ "$timezone" == "$DEFAULT_TIMEZONE" ]] || die "Unexpected timezone: $timezone"
    grep -qx 'LANG=en_US.UTF-8' <<<"$locale_data" || die "Default locale is not en_US.UTF-8."
    grep -q 'napos-wallpaper.svg' <<<"$dconf_data" || die "NapOS wallpaper dconf default is missing."
    validate_cinnamon_panel_defaults "$dconf_data" ||
        die "Cinnamon panel defaults are incomplete or incorrectly positioned."
    validate_cinnamon_copyq_defaults "$dconf_data" ||
        die "Cinnamon CopyQ shortcut defaults are incomplete or incorrect."
    validate_cinnamon_theme_defaults "$dconf_data" ||
        die "Cinnamon theme, pointer, or dark-mode defaults are missing or invalid."
    grep -q '^Name=Install NapOS$' <<<"$installer" || die "Installer launcher is not branded Install NapOS."
    grep -q '^Name\[vi\]=Cài đặt NapOS$' <<<"$installer" || die "Vietnamese installer label is not branded Cài đặt NapOS."
    grep -q '^Icon=napos-logo$' <<<"$installer" || die "Installer launcher icon is not NapOS."
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/backgrounds/napos/napos-wallpaper.svg >/dev/null 2>&1 || die "NapOS wallpaper is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" usr/share/icons/hicolor/scalable/apps/napos-logo.svg >/dev/null 2>&1 || die "NapOS logo is missing."
    unsquashfs -cat "$temp/filesystem.squashfs" \
        usr/share/fonts/truetype/msttcorefonts/Arial.ttf >/dev/null 2>&1 ||
