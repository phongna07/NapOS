    verify_file_sha256_and_size "$packages" "$packages_sha256" "$packages_size" || return 1

    package_metadata=$(onlyoffice_package_metadata "$packages") || return 1
    IFS=$'\t' read -r ONLYOFFICE_VERSION package_filename ONLYOFFICE_DEB_SHA256 ONLYOFFICE_DEB_SIZE \
        <<<"$package_metadata"
    [[ "$package_filename" == pool/main/o/onlyoffice-desktopeditors/*.deb ]] || return 1
    destination="$ONLYOFFICE_DOWNLOAD_DIR/$ONLYOFFICE_DEB_SHA256/$(basename "$package_filename")"
    fetch_onlyoffice_deb "$destination" "$ONLYOFFICE_VERSION" "$ONLYOFFICE_DEB_SHA256" \
        "$ONLYOFFICE_DEB_SIZE" || return 1

    ONLYOFFICE_DEB_PATH=$destination
    ONLYOFFICE_REPOSITORY_PACKAGE_PATH=$package_filename
    ok "Authenticated ONLYOFFICE signing fingerprint: $actual_primary"
    ok "Resolved ONLYOFFICE Desktop Editors: $ONLYOFFICE_VERSION"
}

fetch_onlyoffice() {
    local attempt
    for attempt in 1 2 3; do
        if fetch_onlyoffice_attempt; then
            return 0
        fi
        warn "ONLYOFFICE metadata/package resolution attempt $attempt of 3 failed."
    done
    die "Unable to authenticate a consistent ONLYOFFICE stable package after 3 attempts."
}

quarantine_fcitx5_lotus_file() {
    local path=$1
    local quarantine
    [[ -f "$path" ]] || return 0
    quarantine="${path}.invalid.$(date -u +%Y%m%dT%H%M%SZ)"
    mv -- "$path" "$quarantine"
    warn "Quarantined an invalid Fcitx5 Lotus input at $quarantine"
}

fetch_fcitx5_lotus_deb() {
    local url=$1
    local destination=$2
    local expected_version=$3
    local expected_sha256=$4
    local expected_size=$5
    local part="${destination}.part"

    if [[ -f "$destination" ]]; then
        if validate_fcitx5_lotus_deb "$destination" "$expected_version" \
            "$expected_sha256" "$expected_size"; then
            ok "Using authenticated cached Fcitx5 Lotus $expected_version."
            return 0
        fi
        quarantine_fcitx5_lotus_file "$destination"
    fi

    mkdir -p "$(dirname "$destination")"
    if [[ -f "$part" ]]; then
        quarantine_fcitx5_lotus_file "$part"
    fi
    log "Downloading Fcitx5 Lotus $expected_version..."
    download_transient "$url" "$part" || return 1
    if ! validate_fcitx5_lotus_deb "$part" "$expected_version" \
        "$expected_sha256" "$expected_size"; then
        quarantine_fcitx5_lotus_file "$part"
        return 1
    fi
    mv -- "$part" "$destination"
    ok "Fcitx5 Lotus .deb matches signed repository metadata."
}

fetch_fcitx5_lotus_attempt() {
    local temp gnupg_home armored_key keyring inrelease packages status_file repository
    local actual_primary valid_primary release_metadata packages_sha256 packages_size
    local package_metadata package_filename package_url destination packages_path cached_key cached_key_part

    temp=$(with_temp_dir)
    TEMP_PATHS+=("$temp")
    gnupg_home="$temp/gnupg"
    armored_key="$temp/fcitx5-lotus.asc"
    keyring="$temp/fcitx5-lotus.gpg"
    inrelease="$temp/InRelease"
    packages="$temp/Packages"
    status_file="$temp/gpg.status"
    repository="$FCITX5_LOTUS_APT_ROOT/$UBUNTU_CODENAME"
    packages_path="main/binary-$FCITX5_LOTUS_ARCH/Packages"
    mkdir -m 0700 "$gnupg_home"

    download_transient "$FCITX5_LOTUS_SIGNING_KEY_URL" "$armored_key" || return 1
    actual_primary=$(primary_key_fingerprint "$armored_key") || return 1
    [[ "$(trim_fingerprint "$actual_primary")" == \
        "$(trim_fingerprint "$FCITX5_LOTUS_SIGNING_FINGERPRINT")" ]] || return 1
    gpg --homedir "$gnupg_home" --batch --import "$armored_key" >/dev/null 2>&1 || return 1
    gpg --batch --yes --dearmor --output "$keyring" "$armored_key" || return 1

    download_transient "$repository/dists/$UBUNTU_CODENAME/InRelease" "$inrelease" || return 1
    gpg --homedir "$gnupg_home" --batch --status-fd 1 --verify "$inrelease" \
        >"$status_file" 2>/dev/null || return 1
    valid_primary=$(awk '$2 == "VALIDSIG" { print $NF; exit }' "$status_file")
    [[ "$(trim_fingerprint "$valid_primary")" == \
        "$(trim_fingerprint "$FCITX5_LOTUS_SIGNING_FINGERPRINT")" ]] || return 1

    release_metadata=$(release_file_metadata "$inrelease" "$packages_path") || return 1
    IFS=$'\t' read -r packages_sha256 packages_size <<<"$release_metadata"
    download_transient "$repository/dists/$UBUNTU_CODENAME/$packages_path" "$packages" || return 1
    verify_file_sha256_and_size "$packages" "$packages_sha256" "$packages_size" || return 1

    package_metadata=$(fcitx5_lotus_package_metadata "$packages") || return 1
    IFS=$'\t' read -r FCITX5_LOTUS_VERSION package_filename \
        FCITX5_LOTUS_DEB_SHA256 FCITX5_LOTUS_DEB_SIZE <<<"$package_metadata"
    [[ "$package_filename" == pool/main/f/fcitx5-lotus/*.deb ]] || return 1
    package_url="$repository/$package_filename"
    destination="$FCITX5_LOTUS_DOWNLOAD_DIR/$FCITX5_LOTUS_DEB_SHA256/$(basename "$package_filename")"
    fetch_fcitx5_lotus_deb "$package_url" "$destination" "$FCITX5_LOTUS_VERSION" \
        "$FCITX5_LOTUS_DEB_SHA256" "$FCITX5_LOTUS_DEB_SIZE" || return 1

    mkdir -p "$FCITX5_LOTUS_DOWNLOAD_DIR"
    cached_key="$FCITX5_LOTUS_DOWNLOAD_DIR/fcitx5-lotus-${FCITX5_LOTUS_SIGNING_FINGERPRINT}.gpg"
    cached_key_part="${cached_key}.part"
    if [[ -f "$cached_key" ]] &&
        [[ "$(trim_fingerprint "$(primary_key_fingerprint "$cached_key")")" != \
            "$(trim_fingerprint "$FCITX5_LOTUS_SIGNING_FINGERPRINT")" ]]; then
        quarantine_fcitx5_lotus_file "$cached_key"
    fi
    cp -- "$keyring" "$cached_key_part"
    chmod 0644 "$cached_key_part"
    mv -- "$cached_key_part" "$cached_key"

    FCITX5_LOTUS_DEB_PATH=$destination
    FCITX5_LOTUS_KEY_PATH=$cached_key
    FCITX5_LOTUS_REPOSITORY_PACKAGE_PATH=$package_filename
    ok "Authenticated Fcitx5 Lotus signing fingerprint: $actual_primary"
    ok "Resolved Fcitx5 Lotus: $FCITX5_LOTUS_VERSION"
}

fetch_fcitx5_lotus() {
    local attempt
    for attempt in 1 2 3; do
        if fetch_fcitx5_lotus_attempt; then
            return 0
        fi
        warn "Fcitx5 Lotus metadata/package resolution attempt $attempt of 3 failed."
    done
    die "Unable to authenticate a consistent Fcitx5 Lotus package after 3 attempts."
}

fetch_windows_10_dark_theme() {
    local destination quarantine
    destination="$WINDOWS_10_DARK_THEME_DOWNLOAD_DIR/$WINDOWS_10_DARK_THEME_SHA256/$WINDOWS_10_DARK_THEME_UUID.zip"

    if [[ -f "$destination" ]] &&
        ! validate_windows_10_dark_theme_archive "$destination"; then
        quarantine="${destination}.invalid.$(date -u +%Y%m%dT%H%M%SZ)"
        mv -- "$destination" "$quarantine"
        warn "Quarantined an invalid Windows 10 Dark theme archive at $quarantine"
    fi
    download_atomic "$WINDOWS_10_DARK_THEME_URL" "$destination" \
        "$WINDOWS_10_DARK_THEME_SHA256"
    validate_windows_10_dark_theme_archive "$destination" ||
        die "Windows 10 Dark theme archive failed integrity or content validation."
    WINDOWS_10_DARK_THEME_ARCHIVE_PATH=$destination
    ok "Authenticated Windows 10 Dark theme archive: $WINDOWS_10_DARK_THEME_SHA256"
}

cmd_fetch() {
    local manifest="$DOWNLOAD_DIR/sha256sum.txt"
    local signature="$DOWNLOAD_DIR/sha256sum.txt.gpg"
    local iso="$DOWNLOAD_DIR/$BASE_ISO_NAME"
    local actual quarantine

    validate_config
    mkdir -p "$CACHE_DIR"
    exec 8>"$CACHE_DIR/.fetch.lock"
    flock -n 8 || die "Another NapOS fetch holds $CACHE_DIR/.fetch.lock"
    mkdir -p "$DOWNLOAD_DIR"
    ensure_mint_key
    download_atomic "$BASE_MIRROR/sha256sum.txt" "$manifest"
    download_atomic "$BASE_MIRROR/sha256sum.txt.gpg" "$signature"
    verify_signed_manifest "$manifest" "$signature"

    if [[ -f "$iso" ]]; then
        actual=$(sha256_of "$iso")
        if [[ "$actual" != "$BASE_ISO_SHA256" ]]; then
            quarantine="${iso}.invalid.$(date -u +%Y%m%dT%H%M%SZ)"
            mv -- "$iso" "$quarantine"
            warn "Quarantined an invalid cached ISO at $quarantine"
        fi
    fi
    download_atomic "$BASE_MIRROR/$BASE_ISO_NAME" "$iso" "$BASE_ISO_SHA256"
    actual=$(sha256_of "$iso")
    [[ "$actual" == "$BASE_ISO_SHA256" ]] || die "Base ISO checksum mismatch: $actual"
    printf 'sha256=%s\nverified_at=%s\n' "$actual" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$DOWNLOAD_DIR/$BASE_ISO_NAME.verified"
    ok "Authenticated base ISO SHA-256: $actual"
    ok "Authenticated base ISO: $iso"
    fetch_google_chrome
    fetch_onlyoffice
    fetch_fcitx5_lotus
    fetch_windows_10_dark_theme
}

base_iso_path() {
    local path="$DOWNLOAD_DIR/$BASE_ISO_NAME"
    [[ -f "$path" ]] || cmd_fetch
    [[ "$(sha256_of "$path")" == "$BASE_ISO_SHA256" ]] || die "Cached base ISO no longer matches its pinned hash."
    printf '%s\n' "$path"
}

validate_extracted_base() {
    local root=$1
    local launcher
    [[ -f "$root/iso-tree/casper/filesystem.squashfs" ]] || return 1
    compgen -G "$root/iso-tree/casper/vmlinuz*" >/dev/null || return 1
    compgen -G "$root/iso-tree/casper/initrd*" >/dev/null || return 1
    [[ -d "$root/iso-tree/boot" && -d "$root/iso-tree/EFI" ]] || return 1
    [[ -d "$root/rootfs/etc" && -x "$root/rootfs/bin/bash" ]] || return 1
    [[ -f "$root/rootfs/usr/lib/os-release" || -f "$root/rootfs/etc/os-release" ]] || return 1
    for launcher in \
        usr/share/applications/ubiquity.desktop \
        usr/share/applications/live-installer.desktop \
        usr/share/applications/calamares.desktop; do
        if [[ -f "$root/rootfs/$launcher" ]]; then
            return 0
        fi
    done
    return 1
}

validate_base_cache() {
    local root=$1
    validate_extracted_base "$root" || return 1
    [[ -f "$root/.complete" ]] || return 1
    grep -qx "sha256=$BASE_ISO_SHA256" "$root/.complete" || return 1
    return 0
}

prepare_base_cache() {
    local base_iso tmp boot_report
    if validate_base_cache "$BASE_CACHE_DIR"; then
        ok "Using immutable base cache: $BASE_CACHE_DIR"
        return 0
    fi

    need_sudo
    base_iso=$(base_iso_path)
    mkdir -p "$CACHE_DIR/base"
    tmp="$CACHE_DIR/base/.${BASE_ISO_SHA256}.tmp.$$"
    assert_safe_path "$tmp" "$CACHE_DIR/base" || die "Unsafe base-cache temporary path."
    if [[ -e "$tmp" ]]; then
        require_clean_mount_state "$tmp"
        sudo rm -rf -- "$tmp"
    fi
    mkdir -p "$tmp/iso-tree"

    log "Extracting the authenticated ISO into the immutable cache..."
    xorriso -osirrox on -indev "$base_iso" -extract / "$tmp/iso-tree"
    [[ -f "$tmp/iso-tree/casper/filesystem.squashfs" ]] || die "Base ISO has no Casper SquashFS."

    log "Expanding the base SquashFS..."
    sudo unsquashfs -no-progress -d "$tmp/rootfs" "$tmp/iso-tree/casper/filesystem.squashfs"
    validate_extracted_base "$tmp" || die "Extracted ISO, boot files, installer, or rootfs are incomplete."

    boot_report=$(xorriso -indev "$base_iso" -report_el_torito plain 2>&1)
    grep -q 'BIOS' <<<"$boot_report" || die "Base ISO has no legacy BIOS boot entry."
    grep -Eq 'UEFI|EFI' <<<"$boot_report" || die "Base ISO has no EFI boot entry."

    require_clean_mount_state "$tmp"
    printf 'sha256=%s\ncreated_at=%s\n' "$BASE_ISO_SHA256" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$tmp/.complete"
    if [[ -e "$BASE_CACHE_DIR" ]]; then
        require_clean_mount_state "$BASE_CACHE_DIR"
        sudo rm -rf -- "$BASE_CACHE_DIR"
    fi
    mv -- "$tmp" "$BASE_CACHE_DIR"
    ok "Immutable base cache created."
}

prepare_work_tree() {
    mkdir -p "$WORK_DIR" "$DIST_DIR"
    cleanup_mounts "$ROOTFS"
    safe_remove_tree "$ISO_TREE" "$WORK_DIR"
    safe_remove_tree "$ROOTFS" "$WORK_DIR"
    safe_remove_tree "$META_DIR" "$WORK_DIR"
    mkdir -p "$ISO_TREE" "$META_DIR"

    log "Creating a fresh ISO work tree..."
    rsync -aH --delete "$BASE_CACHE_DIR/iso-tree/" "$ISO_TREE/"
    log "Creating a fresh rootfs work tree..."
    sudo rsync -aHAX --numeric-ids --delete "$BASE_CACHE_DIR/rootfs/" "$ROOTFS/"
    # xorriso preserves the base ISO's read-only Casper directory permissions.
    # Removing an entry from that directory therefore requires the build's
    # already-authenticated sudo context, even though ISO_TREE itself is owned
    # by the invoking user.
    sudo rm -f -- "$ISO_TREE/casper/filesystem.squashfs"
    printf 'sha256=%s\n' "$BASE_ISO_SHA256" >"$META_DIR/source"
    ok "Fresh work tree is ready."
}

prepare_github_work_tree() {
    local base_iso boot_report
    base_iso=$(base_iso_path)
    mkdir -p "$WORK_DIR" "$DIST_DIR"
    cleanup_mounts "$ROOTFS"
    safe_remove_tree "$ISO_TREE" "$WORK_DIR"
    safe_remove_tree "$ROOTFS" "$WORK_DIR"
    safe_remove_tree "$META_DIR" "$WORK_DIR"
    mkdir -p "$ISO_TREE" "$META_DIR"

    log "Extracting the authenticated ISO directly into the GitHub Actions work tree..."
    xorriso -osirrox on -indev "$base_iso" -extract / "$ISO_TREE"
    [[ -f "$ISO_TREE/casper/filesystem.squashfs" ]] || die "Base ISO has no Casper SquashFS."

    log "Expanding the base SquashFS directly into the GitHub Actions rootfs..."
    sudo unsquashfs -no-progress -d "$ROOTFS" "$ISO_TREE/casper/filesystem.squashfs"
    validate_extracted_base "$WORK_DIR" ||
        die "Extracted ISO, boot files, installer, or rootfs are incomplete."

    boot_report=$(xorriso -indev "$base_iso" -report_el_torito plain 2>&1)
    grep -q 'BIOS' <<<"$boot_report" || die "Base ISO has no legacy BIOS boot entry."
    grep -Eq 'UEFI|EFI' <<<"$boot_report" || die "Base ISO has no EFI boot entry."

    sudo mkdir -p "$BASE_REFERENCE_DIR/etc"
    sudo cp -a "$ROOTFS/etc/lsb-release" "$BASE_REFERENCE_DIR/etc/lsb-release"
    sudo cp -a "$ROOTFS/etc/apt" "$BASE_REFERENCE_DIR/etc/apt"
    sudo rm -f -- "$ISO_TREE/casper/filesystem.squashfs"
    printf 'sha256=%s\n' "$BASE_ISO_SHA256" >"$META_DIR/source"
    ok "GitHub Actions work tree created without a duplicate expanded base cache."
}

base_reference_root() {
    if check_github_actions_ubuntu; then
        printf '%s\n' "$BASE_REFERENCE_DIR"
    else
        printf '%s\n' "$BASE_CACHE_DIR/rootfs"
    fi
}

save_and_enable_dns() {
    if [[ -e "$ROOTFS/etc/resolv.conf" || -L "$ROOTFS/etc/resolv.conf" ]]; then
        sudo cp -a "$ROOTFS/etc/resolv.conf" "$META_DIR/resolv.conf.original"
    else
        : >"$META_DIR/resolv.was-missing"
    fi
    sudo rm -f -- "$ROOTFS/etc/resolv.conf"
    sudo cp -L /etc/resolv.conf "$ROOTFS/etc/resolv.conf"
}

restore_dns() {
    sudo rm -f -- "$ROOTFS/etc/resolv.conf"
    if [[ -e "$META_DIR/resolv.conf.original" || -L "$META_DIR/resolv.conf.original" ]]; then
        sudo cp -a "$META_DIR/resolv.conf.original" "$ROOTFS/etc/resolv.conf"
    fi
}

mount_chroot() {
    sudo mount --rbind /dev "$ROOTFS/dev"
    sudo mount --make-rslave "$ROOTFS/dev"
    sudo mount -t proc proc "$ROOTFS/proc"
    sudo mount --rbind /sys "$ROOTFS/sys"
    sudo mount --make-rslave "$ROOTFS/sys"
}

install_packages_and_hooks() {
    local hook hook_name command theme_temp
    [[ -f "$CHROME_DEB_PATH" ]] || die "Authenticated Google Chrome package is unavailable."
    [[ -f "$ONLYOFFICE_DEB_PATH" ]] || die "Authenticated ONLYOFFICE package is unavailable."
    [[ -f "$FCITX5_LOTUS_DEB_PATH" ]] || die "Authenticated Fcitx5 Lotus package is unavailable."
    [[ -f "$FCITX5_LOTUS_KEY_PATH" ]] || die "Authenticated Fcitx5 Lotus keyring is unavailable."
    validate_windows_10_dark_theme_archive "$WINDOWS_10_DARK_THEME_ARCHIVE_PATH" ||
        die "Authenticated Windows 10 Dark theme archive is unavailable or invalid."
    save_and_enable_dns
    printf '#!/bin/sh\nexit 101\n' | sudo tee "$ROOTFS/usr/sbin/policy-rc.d" >/dev/null
    sudo chmod 0755 "$ROOTFS/usr/sbin/policy-rc.d"
    sudo install -m 0644 "$CONFIG_DIR/packages.txt" "$ROOTFS/tmp/napos-packages.txt"
    sudo install -m 0644 "$CONFIG_DIR/packages-remove.txt" "$ROOTFS/tmp/napos-packages-remove.txt"
    sudo install -m 0644 "$CHROME_DEB_PATH" "$ROOTFS/tmp/napos-google-chrome.deb"
    sudo install -m 0644 "$ONLYOFFICE_DEB_PATH" "$ROOTFS/tmp/napos-onlyoffice.deb"
    sudo install -m 0644 "$FCITX5_LOTUS_DEB_PATH" "$ROOTFS/tmp/napos-fcitx5-lotus.deb"
    sudo mkdir -p "$ROOTFS/usr/share/keyrings"
    sudo install -m 0644 "$FCITX5_LOTUS_KEY_PATH" "$ROOTFS/usr/share/keyrings/fcitx5-lotus.gpg"
    sudo mkdir -p "$ROOTFS/tmp/napos-maintscript-bin"
    for command in modprobe udevadm systemctl killall; do
        printf '#!/bin/sh\nexit 0\n' | sudo tee "$ROOTFS/tmp/napos-maintscript-bin/$command" >/dev/null
        sudo chmod 0755 "$ROOTFS/tmp/napos-maintscript-bin/$command"
    done
    sudo mkdir -p "$ROOTFS/tmp/napos-hooks"
    if compgen -G "$CONFIG_DIR/hooks/*.sh" >/dev/null; then
        sudo cp "$CONFIG_DIR"/hooks/*.sh "$ROOTFS/tmp/napos-hooks/"
    fi

    mount_chroot
    log "Installing repository packages in the chroot..."
    sudo chroot "$ROOTFS" /usr/bin/env -i \
        HOME=/root PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        DEBIAN_FRONTEND=noninteractive /bin/bash -euxc '
            apt-get update
            printf "%s\n" \
                "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula boolean true" |
                debconf-set-selections
            sed -e "/^[[:space:]]*#/d" -e "/^[[:space:]]*$/d" /tmp/napos-packages.txt |
                xargs -r apt-get install -y --no-install-recommends
            apt-get install -y --no-install-recommends /tmp/napos-google-chrome.deb
            apt-get install -y --no-install-recommends /tmp/napos-onlyoffice.deb
            /usr/bin/env LOGNAME=root PATH=/tmp/napos-maintscript-bin:/usr/sbin:/usr/bin:/sbin:/bin \
                apt-get install -y --no-install-recommends /tmp/napos-fcitx5-lotus.deb
            systemd-sysusers
            rm -f /etc/systemd/system/multi-user.target.wants/fcitx5-lotus-server@root.service
            sed -e "/^[[:space:]]*#/d" -e "/^[[:space:]]*$/d" /tmp/napos-packages-remove.txt |
                xargs -r apt-get purge -y --
        '

    log "Installing the authenticated Windows 10 Dark theme..."
    theme_temp=$(with_temp_dir)
    TEMP_PATHS+=("$theme_temp")
    unzip -q "$WINDOWS_10_DARK_THEME_ARCHIVE_PATH" -d "$theme_temp"
    [[ -d "$theme_temp/$WINDOWS_10_DARK_THEME_UUID" ]] ||
        die "Windows 10 Dark theme archive did not produce its expected directory."
    if find "$theme_temp/$WINDOWS_10_DARK_THEME_UUID" -type l -print -quit | grep -q .; then
        die "Windows 10 Dark theme archive unexpectedly contains a symbolic link."
    fi
    [[ ! -e "$ROOTFS/usr/share/themes/$WINDOWS_10_DARK_THEME_UUID" ]] ||
        die "Windows 10 Dark theme destination already exists in the base image."
    chmod -R u=rwX,go=rX "$theme_temp/$WINDOWS_10_DARK_THEME_UUID"
    sudo mkdir -p "$ROOTFS/usr/share/themes/$WINDOWS_10_DARK_THEME_UUID"
    sudo rsync -aH "$theme_temp/$WINDOWS_10_DARK_THEME_UUID/" \
        "$ROOTFS/usr/share/themes/$WINDOWS_10_DARK_THEME_UUID/"

    log "Applying the NapOS filesystem overlay..."
    sudo rsync -aHAX "$CONFIG_DIR/overlay/" "$ROOTFS/"

    for hook in "$CONFIG_DIR"/hooks/*.sh; do
        [[ -f "$hook" ]] || continue
        hook_name=$(basename "$hook")
        log "Running customization hook: $hook_name"
        sudo chroot "$ROOTFS" /usr/bin/env -i \
            HOME=/root PATH=/usr/sbin:/usr/bin:/sbin:/bin \
            DEBIAN_FRONTEND=noninteractive \
            NAPOS_NAME="$NAPOS_NAME" NAPOS_ID="$NAPOS_ID" NAPOS_VERSION="$NAPOS_VERSION" \
            NAPOS_EDITION="$NAPOS_EDITION" BASE_VERSION="$BASE_VERSION" BASE_CODENAME="$BASE_CODENAME" \
            UBUNTU_CODENAME="$UBUNTU_CODENAME" DEFAULT_LOCALE="$DEFAULT_LOCALE" \
            DEFAULT_TIMEZONE="$DEFAULT_TIMEZONE" BUILD_PROFILE="$BUILD_PROFILE" \
            BUILD_ID="$BUILD_ID" BUILD_TIMESTAMP="$BUILD_TIMESTAMP" \
            /bin/bash "/tmp/napos-hooks/$hook_name"
    done
}

validate_customized_rootfs() {
