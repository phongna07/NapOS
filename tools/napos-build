cleanup_temp_paths() {
    local path
    for path in "${TEMP_PATHS[@]:-}"; do
        [[ -n "$path" && -e "$path" ]] || continue
        if [[ "$path" == "${TMPDIR:-/tmp}"/napos.* ]]; then
            rm -rf -- "$path" 2>/dev/null || true
        fi
    done
}

on_exit() {
    local status=$?
    if (( ACTIVE_BUILD == 1 )); then
        cleanup_mounts "$ROOTFS"
    fi
    cleanup_temp_paths
    if (( status != 0 )); then
        warn "Command failed with status $status. Disposable work state was preserved for inspection."
    fi
    return "$status"
}

on_signal() {
    local signal_name=$1
    trap - INT TERM
    if (( ACTIVE_CHILD_PID > 0 )); then
        kill "$ACTIVE_CHILD_PID" 2>/dev/null || true
        wait "$ACTIVE_CHILD_PID" 2>/dev/null || true
        ACTIVE_CHILD_PID=0
    fi
    warn "Received $signal_name; stopping the active workflow command."
    exit 130
}
trap on_exit EXIT
trap 'on_signal INT' INT
trap 'on_signal TERM' TERM

usage() {
    cat <<EOF
NapOS automated Linux Mint ISO-remaster workflow

Usage:
  tools/napos-build help
  tools/napos-build doctor
  tools/napos-build fetch
  tools/napos-build build dev
  tools/napos-build build release
  tools/napos-build verify [ISO]
  tools/napos-build inspect [ISO]
  tools/napos-build clean-work
  tools/napos-build clean-cache

Preferred interface:
  make doctor   Validate WSL2/GitHub Ubuntu, tools, storage, sudo, and mounts
  make fetch    Authenticate and cache Linux Mint, applications, input method, and theme
  make dev      Build and verify an LZ4 development ISO
  make release  Build and verify an XZ release ISO
  make verify ISO=dist/NapOS-...iso
  make inspect ISO=dist/NapOS-...iso
  make test     Run non-networked safety and branding checks

Generated files are written below dist/. Builds are not byte-reproducible
because package versions are resolved from live Mint, Ubuntu, Google,
ONLYOFFICE, and Fcitx5 Lotus repositories.

Development artifacts:
  dist/NapOS-${NAPOS_VERSION}-dev-${NAPOS_EDITION}-${NAPOS_ARCH}.iso
  dist/NapOS-${NAPOS_VERSION}-dev-${NAPOS_EDITION}-${NAPOS_ARCH}.iso.sha256
  dist/NapOS-${NAPOS_VERSION}-dev-${NAPOS_EDITION}-${NAPOS_ARCH}.build-info.json
  dist/build-dev.log

Release artifacts use the same names without the -dev suffix.
EOF
}

doctor_check() {
    local description=$1
    shift
    if "$@"; then
        ok "$description"
        return 0
    else
        printf '%s[FAILED]%s %s\n' "$COLOR_RED" "$COLOR_RESET" "$description" >&2
        DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
        return 0
    fi
}

doctor_failure() { doctor_check "$1" false; }

validate_cinnamon_panel_defaults() {
    local dconf_data=$1
    local enabled_applets applet
    local expected_applets=(
        panel1:center:0:menu@cinnamon.org
        panel1:left:1:separator@cinnamon.org
        panel1:center:1:grouped-window-list@cinnamon.org
        panel1:right:0:systray@cinnamon.org
        panel1:right:1:xapp-status@cinnamon.org
        panel1:right:2:notifications@cinnamon.org
        panel1:right:3:printers@cinnamon.org
        panel1:right:4:removable-drives@cinnamon.org
        panel1:right:5:keyboard@cinnamon.org
        panel1:right:6:favorites@cinnamon.org
        panel1:right:7:network@cinnamon.org
        panel1:right:8:sound@cinnamon.org
        panel1:right:9:power@cinnamon.org
        panel1:right:10:calendar@cinnamon.org
        panel1:right:11:cornerbar@cinnamon.org
    )
    enabled_applets=$(awk '
        $0 == "[org/cinnamon]" { active=1; next }
        /^\[/ { active=0 }
        active && /^enabled-applets=/ {
            sub(/^enabled-applets=/, "")
            print
            exit
        }
    ' <<<"$dconf_data")
    [[ -n "$enabled_applets" ]] || return 1
    for applet in "${expected_applets[@]}"; do
        [[ "$enabled_applets" == *"'$applet'"* ]] || return 1
    done
    [[ "$enabled_applets" != *"'panel1:left:0:menu@cinnamon.org'"* ]] || return 1
    [[ "$enabled_applets" != *"'panel1:left:2:grouped-window-list@cinnamon.org'"* ]] || return 1
    [[ "$(awk -F'@cinnamon.org' '{ print NF - 1 }' <<<"$enabled_applets")" == "${#expected_applets[@]}" ]]
}

validate_cinnamon_copyq_defaults() {
    local dconf_data=$1
    awk '
        $0 == "[org/cinnamon/desktop/keybindings]" {
            section="keybindings"
            next
        }
        $0 == "[org/cinnamon/desktop/keybindings/custom-keybindings/custom0]" {
            section="copyq"
            next
        }
        /^\[/ { section="" }
        section == "keybindings" && $0 == "custom-list=[\x27custom0\x27]" { custom_list=1 }
        section == "copyq" && $0 == "name=\x27CopyQ Clipboard History\x27" { name=1 }
        section == "copyq" && $0 == "binding=[\x27<Super>v\x27]" { binding=1 }
        section == "copyq" && $0 == "command=\x27copyq toggle\x27" { command=1 }
        END { exit !(custom_list && name && binding && command) }
    ' <<<"$dconf_data"
}

validate_cinnamon_theme_defaults() {
    local dconf_data=$1
    awk '
        $0 == "[org/cinnamon/desktop/interface]" {
            section="interface"
            next
        }
        $0 == "[org/x/apps/portal]" {
            section="portal"
            next
        }
        $0 == "[org/cinnamon/theme]" {
            section="desktop-theme"
            next
        }
        $0 == "[org/cinnamon/desktop/wm/preferences]" {
            section="window-manager"
            next
        }
        /^\[/ { section="" }
        section == "interface" && $0 == "gtk-theme=\x27Windows-10-Dark\x27" {
            application_theme++
            next
        }
        section == "interface" && $0 == "cursor-theme=\x27Yaru\x27" {
            cursor_theme++
            next
        }
        section == "portal" && $0 == "color-scheme=\x27prefer-dark\x27" {
            dark_mode++
            next
        }
        section == "interface" && /^(gtk-theme|icon-theme|cursor-theme)=/ { forbidden=1 }
        section == "portal" && /^color-scheme=/ { forbidden=1 }
        section == "desktop-theme" && /^name=/ { forbidden=1 }
        section == "window-manager" && /^theme=/ { forbidden=1 }
        END {
            exit !(application_theme == 1 && cursor_theme == 1 && dark_mode == 1 && !forbidden)
        }
    ' <<<"$dconf_data"
}

validate_windows_10_dark_theme_archive() {
    local archive=$1
    local listing entry index_theme
    local required_files=(
        "$WINDOWS_10_DARK_THEME_UUID/LICENSE.md"
        "$WINDOWS_10_DARK_THEME_UUID/index.theme"
        "$WINDOWS_10_DARK_THEME_UUID/gtk-2.0/gtkrc"
        "$WINDOWS_10_DARK_THEME_UUID/gtk-3.0/gtk.css"
        "$WINDOWS_10_DARK_THEME_UUID/gtk-4.0/gtk.css"
    )

    verify_file_sha256_and_size "$archive" "$WINDOWS_10_DARK_THEME_SHA256" \
        "$WINDOWS_10_DARK_THEME_SIZE" || return 1
    unzip -tqq "$archive" >/dev/null 2>&1 || return 1
    listing=$(unzip -Z1 "$archive") || return 1
    [[ -n "$listing" ]] || return 1
    while IFS= read -r entry; do
        [[ "$entry" == "$WINDOWS_10_DARK_THEME_UUID/"* ]] || return 1
        [[ "$entry" != /* && "$entry" != *\\* && "$entry" != *"/../"* &&
            "$entry" != *"/.." ]] || return 1
    done <<<"$listing"
    for entry in "${required_files[@]}"; do
        grep -Fqx "$entry" <<<"$listing" || return 1
    done
    index_theme=$(unzip -p "$archive" "$WINDOWS_10_DARK_THEME_UUID/index.theme") || return 1
    grep -qx "Name=$WINDOWS_10_DARK_THEME_NAME" <<<"$index_theme" || return 1
    grep -qx "GtkTheme=$WINDOWS_10_DARK_THEME_NAME" <<<"$index_theme" || return 1
    unzip -p "$archive" "$WINDOWS_10_DARK_THEME_UUID/LICENSE.md" 2>/dev/null |
        grep -Fq 'GNU GENERAL PUBLIC LICENSE' || return 1
}

check_wsl2() {
    grep -qi 'microsoft-standard-WSL2' /proc/sys/kernel/osrelease
}

check_github_actions_ubuntu() {
    (
        is_github_actions || return 1
        [[ -r /etc/os-release ]] || return 1
        # shellcheck source=/dev/null
        source /etc/os-release
        [[ "${ID:-}" == "ubuntu" ]]
    )
}

check_supported_build_host() {
    check_wsl2 || check_github_actions_ubuntu
}

check_native_filesystem() {
    local type
    [[ "$PROJECT_ROOT" != /mnt/* ]] || return 1
    type=$(stat -f -c '%T' "$PROJECT_ROOT")
    [[ "$type" != "9p" && "$type" != "cifs" && "$type" != "fuseblk" ]]
}

check_disk_space() {
    local available_kib required_kib
    available_kib=$(df -Pk "$PROJECT_ROOT" | awk 'NR==2 {print $4}')
    required_kib=$((MIN_FREE_GIB * 1024 * 1024))
    (( available_kib >= required_kib ))
}

check_tools() {
    local command
    local commands=(awk bash chroot cmp curl cut df diff dpkg dpkg-deb du file find findmnt flock git gpg head jq make md5sum mktemp mount mountpoint mksquashfs mv readlink realpath rm rsync sed sha256sum shellcheck sort stat sudo sync tee unzip unsquashfs xargs xorriso)
    for command in "${commands[@]}"; do
        command -v "$command" >/dev/null 2>&1 || {
            warn "Missing command: $command"
            return 1
        }
    done
}

check_mount_capability() {
    local test_dir
    local status=0
    test_dir=$(with_temp_dir)
    TEMP_PATHS+=("$test_dir")
    mkdir -p "$test_dir/source" "$test_dir/bind" "$test_dir/proc"
    sudo mount --bind "$test_dir/source" "$test_dir/bind" >/dev/null 2>&1 || status=1
    if (( status == 0 )); then
        sudo mount -t proc proc "$test_dir/proc" >/dev/null 2>&1 || status=1
    fi
    if mountpoint -q "$test_dir/proc"; then
        sudo umount "$test_dir/proc" >/dev/null 2>&1 || status=1
    fi
    if mountpoint -q "$test_dir/bind"; then
        sudo umount "$test_dir/bind" >/dev/null 2>&1 || status=1
    fi
    return "$status"
}

cmd_doctor() {
    validate_config
    log "Environment doctor"
    doctor_check "WSL2 or GitHub-hosted Ubuntu detected" check_supported_build_host
    doctor_check "Project uses the native Linux filesystem" check_native_filesystem
    doctor_check "At least ${MIN_FREE_GIB} GiB is available" check_disk_space
    doctor_check "All required commands are installed" check_tools
    [[ ${EUID:-$(id -u)} -ne 0 ]] || die "Run make doctor as your normal user, not root."
    log "Refreshing sudo credentials..."
    if sudo -v; then
        ok "sudo authentication succeeded"
        doctor_check "sudo can create and remove bind and proc mounts" check_mount_capability
    else
        doctor_failure "sudo authentication succeeded"
        doctor_failure "sudo can create and remove bind and proc mounts (not tested)"
    fi
    if (( DOCTOR_FAILURES > 0 )); then
        die "Environment doctor found $DOCTOR_FAILURES failed requirement(s)."
    fi
    ok "Configuration is valid: $NAPOS_NAME $NAPOS_VERSION on Mint $BASE_VERSION"
}

log_disk_usage() {
    local stage=$1
    local available used
    available=$(df -Ph "$PROJECT_ROOT" | awk 'NR == 2 { print $4 }')
    used=$(df -Ph "$PROJECT_ROOT" | awk 'NR == 2 { print $3 }')
    log "Disk usage after $stage: $used used, $available available"
}
run_external() {
    local status=0
    "$@" &
    ACTIVE_CHILD_PID=$!
    wait "$ACTIVE_CHILD_PID" || status=$?
    ACTIVE_CHILD_PID=0
    return "$status"
}


download_atomic() {
    local url=$1
    local destination=$2
    local expected_sha256=${3:-}
    local part="${destination}.part"
    local actual quarantine
    [[ -f "$destination" ]] && return 0
    mkdir -p "$(dirname "$destination")"
    log "Downloading $(basename "$destination")..."
    if ! run_external curl --fail --location --retry 4 --retry-delay 3 --retry-all-errors \
        --connect-timeout 20 --speed-time 60 --speed-limit 1024 \
        --continue-at - --output "$part" "$url"; then
        die "Download failed; resumable partial data was preserved at $part"
    fi
    if [[ -n "$expected_sha256" ]]; then
        actual=$(sha256_of "$part")
        if [[ "$actual" != "$expected_sha256" ]]; then
            quarantine="${part}.invalid.$(date -u +%Y%m%dT%H%M%SZ)"
            mv -- "$part" "$quarantine"
            die "Downloaded checksum mismatch ($actual); quarantined at $quarantine"
        fi
        ok "Downloaded file matches pinned SHA-256 before publication."
    fi
    mv -- "$part" "$destination"
}

ensure_mint_key() {
    local gnupg_home="$CACHE_DIR/gnupg"
    local actual
    local key_file key_url
    mkdir -p "$gnupg_home"
    chmod 0700 "$gnupg_home"

    if ! gpg --homedir "$gnupg_home" --batch --list-keys "$MINT_SIGNING_KEY_ID" >/dev/null 2>&1; then
        log "Importing the Linux Mint ISO signing key..."
        mkdir -p "$DOWNLOAD_DIR"
        key_file="$DOWNLOAD_DIR/linuxmint-signing-key.asc"
        key_url="https://keys.openpgp.org/vks/v1/by-fingerprint/${MINT_SIGNING_FINGERPRINT}"
        download_atomic "$key_url" "$key_file"
        gpg --homedir "$gnupg_home" --batch --import "$key_file" >/dev/null 2>&1 ||
            die "Unable to import the downloaded Linux Mint signing key."
    fi

    actual=$(gpg --homedir "$gnupg_home" --batch --with-colons \
        --fingerprint "$MINT_SIGNING_KEY_ID" | awk -F: '$1 == "fpr" {print $10; exit}')
    [[ "$(trim_fingerprint "$actual")" == "$(trim_fingerprint "$MINT_SIGNING_FINGERPRINT")" ]] ||
        die "Mint signing-key fingerprint mismatch: $actual"
    ok "Mint signing-key fingerprint: $actual"
}

verify_signed_manifest() {
    local manifest=$1
    local signature=$2
    local gnupg_home="$CACHE_DIR/gnupg"
    local status_file valid_fingerprint manifest_hash
    status_file=$(mktemp "${TMPDIR:-/tmp}/napos.gpg.XXXXXXXX")
    TEMP_PATHS+=("$status_file")

    gpg --homedir "$gnupg_home" --batch --status-fd 1 \
        --verify "$signature" "$manifest" >"$status_file" 2>/dev/null ||
        die "Linux Mint checksum-manifest signature verification failed."
    valid_fingerprint=$(awk '$2 == "VALIDSIG" {print $3; exit}' "$status_file")
    [[ "$(trim_fingerprint "$valid_fingerprint")" == "$(trim_fingerprint "$MINT_SIGNING_FINGERPRINT")" ]] ||
        die "Manifest was signed by an unexpected key: $valid_fingerprint"
    ok "Detached checksum-manifest signature is valid."

    manifest_hash=$(awk -v file="$BASE_ISO_NAME" '
        $2 == file || $2 == "*" file {print $1; exit}
    ' "$manifest")
    [[ -n "$manifest_hash" ]] || die "$BASE_ISO_NAME is missing from the signed manifest."
    [[ "$manifest_hash" == "$BASE_ISO_SHA256" ]] ||
        die "Signed manifest hash differs from config/source.lock: $manifest_hash"
    ok "Signed manifest matches the pinned ISO hash."
}

download_transient() {
    local url=$1
    local destination=$2
    run_external curl --fail --location --retry 2 --retry-delay 2 --retry-all-errors \
        --connect-timeout 20 --speed-time 60 --speed-limit 1024 \
        --output "$destination" "$url"
}

quarantine_chrome_file() {
    local path=$1
    local quarantine
    [[ -f "$path" ]] || return 0
    quarantine="${path}.invalid.$(date -u +%Y%m%dT%H%M%SZ)"
    mv -- "$path" "$quarantine"
    warn "Quarantined an invalid Chrome package at $quarantine"
}

validate_chrome_deb() {
    local path=$1
    local expected_version=$2
    local expected_sha256=$3
    local expected_size=$4
    local package version architecture
    verify_file_sha256_and_size "$path" "$expected_sha256" "$expected_size" || return 1
    package=$(dpkg-deb -f "$path" Package 2>/dev/null) || return 1
    version=$(dpkg-deb -f "$path" Version 2>/dev/null) || return 1
    architecture=$(dpkg-deb -f "$path" Architecture 2>/dev/null) || return 1
    [[ "$package" == "$GOOGLE_CHROME_PACKAGE" ]] || return 1
    [[ "$version" == "$expected_version" ]] || return 1
    [[ "$architecture" == "$GOOGLE_CHROME_ARCH" ]]
}

fetch_chrome_deb() {
    local destination=$1
    local expected_version=$2
    local expected_sha256=$3
    local expected_size=$4
    local part="${destination}.part"

    if [[ -f "$destination" ]]; then
        if validate_chrome_deb "$destination" "$expected_version" "$expected_sha256" "$expected_size"; then
            ok "Using authenticated cached Google Chrome $expected_version."
            return 0
        fi
        quarantine_chrome_file "$destination"
    fi

    mkdir -p "$(dirname "$destination")"
    if [[ -f "$part" ]]; then
        quarantine_chrome_file "$part"
    fi
    log "Downloading Google Chrome stable $expected_version..."
    download_transient "$GOOGLE_CHROME_DEB_URL" "$part" || return 1
    if ! validate_chrome_deb "$part" "$expected_version" "$expected_sha256" "$expected_size"; then
        quarantine_chrome_file "$part"
        return 1
    fi
    mv -- "$part" "$destination"
    ok "Google Chrome .deb matches signed repository metadata."
}

fetch_google_chrome_attempt() {
    local temp gnupg_home key_file inrelease packages status_file
    local actual_primary valid_primary release_metadata packages_sha256 packages_size
    local package_metadata package_filename destination

    temp=$(with_temp_dir)
    TEMP_PATHS+=("$temp")
    gnupg_home="$temp/gnupg"
    key_file="$temp/linux_signing_key.pub"
    inrelease="$temp/InRelease"
    packages="$temp/Packages"
    status_file="$temp/gpg.status"
    mkdir -m 0700 "$gnupg_home"

    download_transient "$GOOGLE_CHROME_SIGNING_KEY_URL" "$key_file" || return 1
    actual_primary=$(primary_key_fingerprint "$key_file") || return 1
    [[ "$(trim_fingerprint "$actual_primary")" == "$(trim_fingerprint "$GOOGLE_CHROME_SIGNING_FINGERPRINT")" ]] || return 1
    gpg --homedir "$gnupg_home" --batch --import "$key_file" >/dev/null 2>&1 || return 1

    download_transient "$GOOGLE_CHROME_APT_URL/dists/stable/InRelease" "$inrelease" || return 1
    gpg --homedir "$gnupg_home" --batch --status-fd 1 --verify "$inrelease" \
        >"$status_file" 2>/dev/null || return 1
    valid_primary=$(awk '$2 == "VALIDSIG" { print $NF; exit }' "$status_file")
    [[ "$(trim_fingerprint "$valid_primary")" == "$(trim_fingerprint "$GOOGLE_CHROME_SIGNING_FINGERPRINT")" ]] || return 1

    release_metadata=$(release_file_metadata "$inrelease" "main/binary-$GOOGLE_CHROME_ARCH/Packages") || return 1
    IFS=$'\t' read -r packages_sha256 packages_size <<<"$release_metadata"
    download_transient "$GOOGLE_CHROME_APT_URL/dists/stable/main/binary-$GOOGLE_CHROME_ARCH/Packages" "$packages" || return 1
    verify_file_sha256_and_size "$packages" "$packages_sha256" "$packages_size" || return 1

    package_metadata=$(chrome_package_metadata "$packages") || return 1
    IFS=$'\t' read -r CHROME_VERSION package_filename CHROME_DEB_SHA256 CHROME_DEB_SIZE <<<"$package_metadata"
    [[ "$package_filename" == pool/main/g/google-chrome-stable/*.deb ]] || return 1
    destination="$CHROME_DOWNLOAD_DIR/$CHROME_DEB_SHA256/$(basename "$package_filename")"
    fetch_chrome_deb "$destination" "$CHROME_VERSION" "$CHROME_DEB_SHA256" "$CHROME_DEB_SIZE" || return 1

    CHROME_DEB_PATH=$destination
    CHROME_REPOSITORY_PACKAGE_PATH=$package_filename
    ok "Authenticated Google Chrome signing fingerprint: $actual_primary"
    ok "Resolved Google Chrome stable: $CHROME_VERSION"
}

fetch_google_chrome() {
    local attempt
    for attempt in 1 2 3; do
        if fetch_google_chrome_attempt; then
            return 0
        fi
        warn "Google Chrome metadata/package resolution attempt $attempt of 3 failed."
    done
    die "Unable to authenticate a consistent Google Chrome stable package after 3 attempts."
}

