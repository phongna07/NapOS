    unsquashfs -cat "$temp/filesystem.squashfs" \
        usr/share/fonts/truetype/msttcorefonts/Times_New_Roman.ttf >/dev/null 2>&1 ||
        die "Microsoft Times New Roman font payload is missing."
    theme_index=$(unsquashfs -cat "$temp/filesystem.squashfs" \
        usr/share/themes/Windows-10-Dark/index.theme 2>/dev/null) ||
        die "Windows 10 Dark theme metadata is missing."
    grep -qx "Name=$WINDOWS_10_DARK_THEME_NAME" <<<"$theme_index" ||
        die "Windows 10 Dark theme metadata has the wrong name."
    grep -qx "GtkTheme=$WINDOWS_10_DARK_THEME_NAME" <<<"$theme_index" ||
        die "Windows 10 Dark theme metadata has the wrong GTK theme."
    for theme_file in gtk-2.0/gtkrc gtk-3.0/gtk.css gtk-4.0/gtk.css LICENSE.md; do
        unsquashfs -cat "$temp/filesystem.squashfs" \
            "usr/share/themes/Windows-10-Dark/$theme_file" >/dev/null 2>&1 ||
            die "Windows 10 Dark theme payload is missing: $theme_file"
    done
    unsquashfs -cat "$temp/filesystem.squashfs" \
        usr/share/icons/Yaru/cursors/left_ptr >/dev/null 2>&1 ||
        die "Yaru mouse-pointer payload is missing."

    for package in vlc flameshot copyq ibus ttf-mscorefonts-installer \
        gtk2-engines-murrine gtk2-engines-pixbuf \
        fcitx5 fcitx5-config-qt fcitx5-frontend-all \
        "$GOOGLE_CHROME_PACKAGE" "$ONLYOFFICE_PACKAGE" "$FCITX5_LOTUS_PACKAGE"; do
        grep -Eq "^${package} " "$temp/filesystem.manifest" || die "Package is absent from filesystem.manifest: $package"
    done
    while IFS= read -r package; do
        if grep -Eq "^${package}([[:space:]]|$)" "$temp/filesystem.manifest"; then
            die "Package from the removal policy is present in filesystem.manifest: $package"
        fi
    done < <(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$CONFIG_DIR/packages-remove.txt")
    chrome_version=$(awk -v wanted="$GOOGLE_CHROME_PACKAGE" '$1 == wanted { print $2; exit }' \
        "$temp/filesystem.manifest")
    [[ -n "$chrome_version" ]] || die "Google Chrome version is absent from filesystem.manifest."
    if grep -Eq "^${GOOGLE_CHROME_PACKAGE}([[:space:]]|$)" "$temp/filesystem.manifest-remove"; then
        die "Google Chrome is listed for removal by the live installer."
    fi
    onlyoffice_version=$(awk -v wanted="$ONLYOFFICE_PACKAGE" '$1 == wanted { print $2; exit }' \
        "$temp/filesystem.manifest")
    [[ -n "$onlyoffice_version" ]] || die "ONLYOFFICE version is absent from filesystem.manifest."
    if grep -Eq "^${ONLYOFFICE_PACKAGE}([[:space:]]|$)" "$temp/filesystem.manifest-remove"; then
        die "ONLYOFFICE is listed for removal by the live installer."
    fi
    lotus_version=$(awk -v wanted="$FCITX5_LOTUS_PACKAGE" '$1 == wanted { print $2; exit }' \
        "$temp/filesystem.manifest")
    [[ -n "$lotus_version" ]] || die "Fcitx5 Lotus version is absent from filesystem.manifest."
    if grep -Eq "^${FCITX5_LOTUS_PACKAGE}([[:space:]]|$)" "$temp/filesystem.manifest-remove"; then
        die "Fcitx5 Lotus is listed for removal by the live installer."
    fi
    if grep -Eq '^ttf-mscorefonts-installer([[:space:]]|$)' \
        "$temp/filesystem.manifest-remove"; then
        die "Microsoft core fonts installer is listed for removal by the live installer."
    fi
    if grep -q 'Napos' <<<"$napos_release$os_release$installer"; then
        die 'Incorrect product capitalization "Napos" found in the ISO.'
    fi

    build_info="${iso%.iso}.build-info.json"
    if [[ -f "$build_info" ]]; then
        [[ "$(jq -r .build_id "$build_info")" == "$(sed -n 's/^NAPOS_BUILD_ID="\(.*\)"$/\1/p' <<<"$napos_release")" ]] ||
            die "Adjacent and embedded build IDs differ."
        [[ "$(jq -r .compression "$build_info")" == "$compression" ]] ||
            die "Adjacent provenance and SquashFS compression differ."
        [[ "$(jq -r .source.manifest_remove_sha256 "$build_info")" == "$(sha256_of "$temp/filesystem.manifest-remove")" ]] ||
            die "Adjacent provenance and manifest-remove hash differ."
        [[ "$(jq -r .source.package_remove_list_sha256 "$build_info")" == "$(package_remove_list_hash)" ]] ||
            die "Adjacent provenance and package-removal policy hash differ."
        [[ "$(jq -r .source.google_chrome.package "$build_info")" == "$GOOGLE_CHROME_PACKAGE" ]] ||
            die "Adjacent provenance has an unexpected Google Chrome package name."
        [[ "$(jq -r .source.google_chrome.version "$build_info")" == "$chrome_version" ]] ||
            die "Adjacent provenance and Google Chrome manifest versions differ."
        [[ "$(jq -r .source.google_chrome.architecture "$build_info")" == "$GOOGLE_CHROME_ARCH" ]] ||
            die "Adjacent provenance has an unexpected Google Chrome architecture."
        [[ "$(jq -r .source.google_chrome.url "$build_info")" == "$GOOGLE_CHROME_DEB_URL" ]] ||
            die "Adjacent provenance has an unexpected Google Chrome download URL."
        [[ "$(jq -r .source.google_chrome.repository "$build_info")" == "$GOOGLE_CHROME_APT_URL" ]] ||
            die "Adjacent provenance has an unexpected Google Chrome repository."
        [[ "$(jq -r .source.google_chrome.repository_package_path "$build_info")" == pool/main/g/google-chrome-stable/*.deb ]] ||
            die "Adjacent provenance has an unexpected Google Chrome repository package path."
        [[ "$(jq -r .source.google_chrome.signing_fingerprint "$build_info")" == "$GOOGLE_CHROME_SIGNING_FINGERPRINT" ]] ||
            die "Adjacent provenance has an unexpected Google Chrome signing fingerprint."
        [[ "$(jq -r .source.google_chrome.sha256 "$build_info")" =~ ^[a-f0-9]{64}$ ]] ||
            die "Adjacent provenance has an invalid Google Chrome SHA-256."
        [[ "$(jq -r .source.onlyoffice.package "$build_info")" == "$ONLYOFFICE_PACKAGE" ]] ||
            die "Adjacent provenance has an unexpected ONLYOFFICE package name."
        [[ "$(jq -r .source.onlyoffice.version "$build_info")" == "$onlyoffice_version" ]] ||
            die "Adjacent provenance and ONLYOFFICE manifest versions differ."
        [[ "$(jq -r .source.onlyoffice.architecture "$build_info")" == "$ONLYOFFICE_ARCH" ]] ||
            die "Adjacent provenance has an unexpected ONLYOFFICE architecture."
        [[ "$(jq -r .source.onlyoffice.url "$build_info")" == "$ONLYOFFICE_DEB_URL" ]] ||
            die "Adjacent provenance has an unexpected ONLYOFFICE download URL."
        [[ "$(jq -r .source.onlyoffice.repository "$build_info")" == "$ONLYOFFICE_APT_URL" ]] ||
            die "Adjacent provenance has an unexpected ONLYOFFICE repository."
        [[ "$(jq -r .source.onlyoffice.repository_suite "$build_info")" == "$ONLYOFFICE_APT_SUITE" ]] ||
            die "Adjacent provenance has an unexpected ONLYOFFICE repository suite."
        [[ "$(jq -r .source.onlyoffice.repository_package_path "$build_info")" == \
            pool/main/o/onlyoffice-desktopeditors/*.deb ]] ||
            die "Adjacent provenance has an unexpected ONLYOFFICE repository package path."
        [[ "$(jq -r .source.onlyoffice.signing_fingerprint "$build_info")" == \
            "$ONLYOFFICE_SIGNING_FINGERPRINT" ]] ||
            die "Adjacent provenance has an unexpected ONLYOFFICE signing fingerprint."
        [[ "$(jq -r .source.onlyoffice.sha256 "$build_info")" =~ ^[a-f0-9]{64}$ ]] ||
            die "Adjacent provenance has an invalid ONLYOFFICE SHA-256."
        [[ "$(jq -r .source.fcitx5_lotus.package "$build_info")" == "$FCITX5_LOTUS_PACKAGE" ]] ||
            die "Adjacent provenance has an unexpected Fcitx5 Lotus package name."
        [[ "$(jq -r .source.fcitx5_lotus.version "$build_info")" == "$lotus_version" ]] ||
            die "Adjacent provenance and Fcitx5 Lotus manifest versions differ."
        [[ "$(jq -r .source.fcitx5_lotus.architecture "$build_info")" == "$FCITX5_LOTUS_ARCH" ]] ||
            die "Adjacent provenance has an unexpected Fcitx5 Lotus architecture."
        [[ "$(jq -r .source.fcitx5_lotus.repository "$build_info")" == \
            "$FCITX5_LOTUS_APT_ROOT/$UBUNTU_CODENAME" ]] ||
            die "Adjacent provenance has an unexpected Fcitx5 Lotus repository."
        [[ "$(jq -r .source.fcitx5_lotus.repository_suite "$build_info")" == "$UBUNTU_CODENAME" ]] ||
            die "Adjacent provenance has an unexpected Fcitx5 Lotus repository suite."
        [[ "$(jq -r .source.fcitx5_lotus.repository_package_path "$build_info")" == \
            pool/main/f/fcitx5-lotus/*.deb ]] ||
            die "Adjacent provenance has an unexpected Fcitx5 Lotus repository package path."
        [[ "$(jq -r .source.fcitx5_lotus.signing_fingerprint "$build_info")" == \
            "$FCITX5_LOTUS_SIGNING_FINGERPRINT" ]] ||
            die "Adjacent provenance has an unexpected Fcitx5 Lotus signing fingerprint."
        [[ "$(jq -r .source.fcitx5_lotus.sha256 "$build_info")" =~ ^[a-f0-9]{64}$ ]] ||
            die "Adjacent provenance has an invalid Fcitx5 Lotus SHA-256."
        [[ "$(jq -r .source.windows_10_dark_theme.name "$build_info")" == \
            "$WINDOWS_10_DARK_THEME_NAME" ]] ||
            die "Adjacent provenance has an unexpected Windows 10 Dark theme name."
        [[ "$(jq -r .source.windows_10_dark_theme.url "$build_info")" == \
            "$WINDOWS_10_DARK_THEME_URL" ]] ||
            die "Adjacent provenance has an unexpected Windows 10 Dark theme URL."
        [[ "$(jq -r .source.windows_10_dark_theme.catalog_commit "$build_info")" == \
            "$WINDOWS_10_DARK_THEME_CATALOG_COMMIT" ]] ||
            die "Adjacent provenance has an unexpected Windows 10 Dark theme catalog commit."
        [[ "$(jq -r .source.windows_10_dark_theme.size "$build_info")" == \
            "$WINDOWS_10_DARK_THEME_SIZE" ]] ||
            die "Adjacent provenance has an unexpected Windows 10 Dark theme size."
        [[ "$(jq -r .source.windows_10_dark_theme.sha256 "$build_info")" == \
            "$WINDOWS_10_DARK_THEME_SHA256" ]] ||
            die "Adjacent provenance has an unexpected Windows 10 Dark theme SHA-256."
        [[ "$(jq -r .source.windows_10_dark_theme.license "$build_info")" == \
            "$WINDOWS_10_DARK_THEME_LICENSE" ]] ||
            die "Adjacent provenance has an unexpected Windows 10 Dark theme license."
    fi
    ok "NapOS identity, packages, locale, timezone, artwork, and installer metadata are valid."
    ok "Verified ISO: $iso"
}

cmd_inspect() {
    local iso temp
    iso=$(resolve_iso_argument "${1:-}")
    printf 'ISO: %s\nSize: %s\nSHA-256: %s\n\n' "$iso" "$(du -h "$iso" | awk '{print $1}')" "$(sha256_of "$iso")"
    xorriso -indev "$iso" -pvd_info 2>&1 | sed -n '/Volume Id/p;/Volume id/p;/Creation Time/p'
    printf '\nBoot equipment:\n'
    xorriso -indev "$iso" -report_el_torito plain 2>&1
    temp=$(with_temp_dir)
    TEMP_PATHS+=("$temp")
    extract_verification_files "$iso" "$temp"
    printf '\nSquashFS:\n'
    unsquashfs -s "$temp/filesystem.squashfs"
    printf '\nNapOS release:\n'
    unsquashfs -cat "$temp/filesystem.squashfs" etc/napos-release 2>/dev/null
    printf '\nSelected packages:\n'
    for package in vlc flameshot copyq ttf-mscorefonts-installer \
        gtk2-engines-murrine gtk2-engines-pixbuf \
        fcitx5 fcitx5-config-qt fcitx5-frontend-all \
        "$GOOGLE_CHROME_PACKAGE" "$ONLYOFFICE_PACKAGE" "$FCITX5_LOTUS_PACKAGE"; do
        awk -v wanted="$package" '$1 == wanted {print; found=1} END {if (!found) print wanted " (missing)"}' \
            "$temp/filesystem.manifest"
    done
    printf '\nRemoval policy:\n'
    while IFS= read -r package; do
        awk -v wanted="$package" '$1 == wanted {print; found=1} END {if (!found) print wanted " (absent)"}' \
            "$temp/filesystem.manifest"
    done < <(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$CONFIG_DIR/packages-remove.txt")
    if [[ -f "${iso%.iso}.build-info.json" ]]; then
        printf '\nBuild information:\n'
        jq . "${iso%.iso}.build-info.json"
    fi
}

cmd_build() {
    local profile=${1:-}
    local output log_file
    [[ "$profile" == "dev" || "$profile" == "release" ]] || die "Build profile must be dev or release."
    validate_config
    cmd_doctor
    mkdir -p "$WORK_DIR" "$DIST_DIR"
    exec 9>"$WORK_DIR/.build.lock"
    flock -n 9 || die "Another NapOS build holds $WORK_DIR/.build.lock"

    BUILD_PROFILE=$profile
    BUILD_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    BUILD_STARTED_AT=$(date +%s)
    log_file="$DIST_DIR/build-${profile}.log"
    : >"$log_file"
    exec > >(tee -a "$log_file") 2>&1
    ACTIVE_BUILD=1

    cmd_fetch
    log_disk_usage "authenticated input fetch"
    BUILD_ID=$(build_id)
    export BUILD_PROFILE BUILD_ID BUILD_TIMESTAMP
    log "Starting NapOS $NAPOS_VERSION $profile build (build ID $BUILD_ID)"
    if check_github_actions_ubuntu; then
        prepare_github_work_tree
    else
        prepare_base_cache
        prepare_work_tree
    fi
    log_disk_usage "base extraction"
    install_packages_and_hooks
    validate_customized_rootfs
    log_disk_usage "customization"
    clean_chroot
    build_squashfs "$profile"
    write_iso_md5s
    log_disk_usage "SquashFS packing"
    release_github_rootfs
    repack_iso "$profile"
    output=$BUILT_ISO
    log_disk_usage "ISO repacking"
    release_github_intermediates
    cmd_verify "$output"
    ACTIVE_BUILD=0
    ok "Build complete: $output"
    ok "Checksum: $(sha256_of "$output")"
    ok "Size: $(du -h "$output" | awk '{print $1}')"
    ok "Log: $log_file"
}

cmd_clean_work() {
    mkdir -p "$WORK_DIR"
    exec 9>"$WORK_DIR/.build.lock"
    flock -n 9 || die "Refusing cleanup while another NapOS build is active."
    need_sudo
    cleanup_mounts "$ROOTFS"
    for path in "$ISO_TREE" "$ROOTFS" "$META_DIR"; do
        safe_remove_tree "$path" "$WORK_DIR"
    done
    ok "Removed disposable work state; authenticated caches were preserved."
}

cmd_clean_cache() {
    mkdir -p "$CACHE_DIR" "$WORK_DIR"
    exec 9>"$WORK_DIR/.build.lock"
    flock -n 9 || die "Refusing cache cleanup while a NapOS build is active."
    exec 8>"$CACHE_DIR/.fetch.lock"
    flock -n 8 || die "Refusing cache cleanup while a NapOS fetch or build is active."
    need_sudo
    cleanup_mounts "$ROOTFS"
    require_clean_mount_state "$CACHE_DIR"
    for path in "$CACHE_DIR/downloads" "$CACHE_DIR/base" "$CACHE_DIR/gnupg"; do
        [[ -e "$path" ]] || continue
        safe_remove_tree "$path" "$CACHE_DIR"
    done
    ok "Removed authenticated downloads, extraction caches, and isolated GPG state."
}

case "${1:-help}" in
    help|-h|--help) usage ;;
    doctor) cmd_doctor ;;
    fetch) cmd_fetch ;;
    build) cmd_build "${2:-}" ;;
    verify) cmd_verify "${2:-}" ;;
    inspect) cmd_inspect "${2:-}" ;;
    clean-work) cmd_clean_work ;;
    clean-cache) cmd_clean_cache ;;
    *) die "Unknown command: ${1:-}. Run make help." ;;
esac
